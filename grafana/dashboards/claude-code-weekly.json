  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "주간 대비 증감: 비용 (최근 7일 vs 직전 7일)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 9,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "label_replace(sum(sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | keep cost_usd | unwrap cost_usd [7d])), \"metric\", \"1. 비용\", \"\", \"\") or label_replace((sum(sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | keep cost_usd | unwrap cost_usd [7d])) / count(sum by (prompt_id) (count_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | keep prompt_id [7d])))), \"metric\", \"2. 턴당 평균 비용\", \"\", \"\")",
          "queryType": "instant"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "label_replace((sum(sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | keep cost_usd | unwrap cost_usd [7d] offset 7d)) or vector(0)), \"metric\", \"1. 비용\", \"\", \"\") or label_replace(((sum(sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | keep cost_usd | unwrap cost_usd [7d] offset 7d)) / count(sum by (prompt_id) (count_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | keep prompt_id [7d] offset 7d)))) or vector(0)), \"metric\", \"2. 턴당 평균 비용\", \"\", \"\")",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "exclude": {
              "names": [
                "Time"
              ]
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "alias": "증감",
            "binary": {
              "left": {
                "matcher": {
                  "id": "byName",
                  "options": "Value #A"
                }
              },
              "operator": "-",
              "right": {
                "matcher": {
                  "id": "byName",
                  "options": "Value #B"
                }
              }
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "alias": "증감률",
            "binary": {
              "left": {
                "matcher": {
                  "id": "byName",
                  "options": "증감"
                }
              },
              "operator": "/",
              "right": {
                "matcher": {
                  "id": "byName",
                  "options": "Value #B"
                }
              }
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "metric": 0,
              "Value #A": 1,
              "Value #B": 2
            },
            "renameByName": {
              "Value #A": "최근 7일",
              "Value #B": "직전 7일"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "sishort",
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "비용 (USD)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(시작|마지막 활동)$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(metric)$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "string"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(session_id|prompt_id)$"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 300
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "bytes"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "\\(ms\\)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "metric"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "항목"
              },
              {
                "id": "custom.width",
                "value": 230
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(최근 7일|직전 7일|증감)$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "증감률"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "range",
                    "options": {
                      "from": 1000000000000000.0,
                      "result": {
                        "text": "–",
                        "color": "text",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "null+nan",
                      "result": {
                        "text": "–",
                        "color": "text",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "text",
                      "value": -0.05
                    },
                    {
                      "color": "red",
                      "value": 0.05
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "metric",
            "desc": false
          }
        ],
        "footer": {
          "show": false
        }
      },
      "description": "대시보드 시간 범위의 끝 시각을 기준으로 최근 7일과 그 직전 7일을 비교한다(시간 범위 길이·세션 필터와 무관, 전체 세션 대상). 직전 7일에 데이터가 없으면 증감률은 – 로 나온다."
